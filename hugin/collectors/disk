#!/usr/bin/env bash
set -u

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
. "$SCRIPT_DIR/lib.sh"

check=$(collector_check_id "disk")
path=${HUGIN_DISK_PATH:-/}

df_output=$(df -Pk "$path" 2>&1)
if [ $? -ne 0 ]; then
	emit_error "$check" "DF_FAILED" "$df_output"
	exit 0
fi

line=$(printf '%s\n' "$df_output" | awk 'NR == 2 {print}')
if [ -z "$line" ]; then
	emit_error "$check" "DF_NO_DATA" "df did not return filesystem data for $path"
	exit 0
fi

read -r filesystem size_kb used_kb available_kb used_pct mount_point <<EOF
$(printf '%s\n' "$line" | awk '{gsub(/%/, "", $5); print $1, $2, $3, $4, $5, $6}')
EOF

if [[ ! "$size_kb" =~ ^[0-9]+$ ]] || [[ ! "$used_kb" =~ ^[0-9]+$ ]] || [[ ! "$available_kb" =~ ^[0-9]+$ ]] || [[ ! "$used_pct" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
	emit_error "$check" "DF_PARSE_FAILED" "could not parse numeric df fields for $path"
	exit 0
fi

printf '{"check":%s,"status":"ok","metrics":{"path":%s,"mount_point":%s,"filesystem":%s,"size_kb":%s,"used_kb":%s,"available_kb":%s,"used_pct":%s}}\n' \
	"$(json_string "$check")" \
	"$(json_string "$path")" \
	"$(json_string "$mount_point")" \
	"$(json_string "$filesystem")" \
	"$size_kb" \
	"$used_kb" \
	"$available_kb" \
	"$used_pct"
